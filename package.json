{
  "name": "stepscript",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.recorder.config.ts && node scripts/verify-extension-build.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run src/integration",
    "prepare:test:exported": "tsx scripts/prepare-export-validation.ts",
    "serve:test:exported": "vite tests/export-validation/fixture --host 127.0.0.1 --port 4174 --strictPort",
    "test:exported:playwright": "playwright test --config tests/export-validation/playwright.config.ts",
    "test:exported:cypress:run": "tsx scripts/run-cypress-export-validation.ts",
    "test:exported:cypress": "start-server-and-test serve:test:exported http://127.0.0.1:4174 test:exported:cypress:run",
    "test:exported": "npm run prepare:test:exported && npm run test:exported:playwright && npm run test:exported:cypress",
    "prepare:test:extension": "tsx scripts/prepare-extension-e2e.ts",
    "serve:test:extension": "vite tests/extension-e2e/fixture --host 127.0.0.1 --port 4175 --strictPort",
    "test:extension": "npm run build && npm run prepare:test:extension && tsx scripts/run-extension-e2e.ts",
    "prepare:privacy-site": "node scripts/prepare-privacy-site.mjs",
    "test:watch": "vitest",
    "package:extension": "npm run build && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "bestzip": "^3.0.2",
    "cypress": "^15.21.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "start-server-and-test": "^3.0.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
